# Firebase Web config — ambil dari Firebase Console:
# Project settings > General > Your apps > SDK setup and configuration (Config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=islandgrid-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=islandgrid-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=islandgrid-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side saja (JANGAN diberi awalan NEXT_PUBLIC_) ---

# Kredensial admin: dipakai untuk kirim FCM (/api/broadcast) dan scripts/seed.ts.
# Firebase Console > Project settings > Service accounts > Generate new private key
# Lokal: pakai path file. Produksi/VPS: isi FIREBASE_SERVICE_ACCOUNT_JSON (JSON satu baris).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Topic FCM yang di-subscribe aplikasi Android warga (ListrikSiberut).
FCM_TOPIC=WARGA

# Kunci untuk route yang dipanggil cron server (auto-broadcast, verifikasi, sesi).
# Buat acak: openssl rand -hex 32
CRON_SECRET=

# Layanan prediksi ML (FastAPI, repo zhhraid/islandgrid-ai-ml).
# Di VPS yang sama: http://127.0.0.1:8099 (port di-bind ke localhost, tidak publik).
# Kosong = tombol "Perbarui Prediksi" nonaktif; dashboard tetap jalan dari Firestore.
ISLANDGRID_API_BASE_URL=
ISLANDGRID_API_KEY=

# --- AI (Gemini, endpoint kompatibel-OpenAI) — server-side saja ---
# Kunci dari Google AI Studio. Kosong = semua fitur AI nonaktif, aplikasi tetap
# jalan dengan aturan biasa (verifikasi waktu, pesan imbauan templat).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
LLM_MAKS_TOKEN=2000
# Batas waktu default per panggilan (detik). Analisis foto di server memakai batas lebih longgar.
LLM_BATAS_DETIK=12
